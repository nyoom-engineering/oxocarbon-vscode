{
  "update.releaseTrack": "prerelease",
  "update.showReleaseNotes": false,

  "editor.fontFamily": "Berkeley Mono Retina",
  "editor.fontLigatures": "'calt', 'ss01', 'ss04', 'ss05', 'ss06'",

  //  "editor.fontFamily": "Liga SFMono Nerd Font",
  //  "editor.fontFamily": "IBM Plex Mono",
  //  "editor.fontLigatures": true,

  "telemetry.enableCrashReporter": false,
  "telemetry.enableTelemetry": false,
  "telemetry.telemetryLevel": "off",

  // experimental
  //  "editor.experimental.treeSitterTelemetry": true,
  "editor.experimentalEditContextEnabled": true,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "notebook.diff.experimental.toggleInline": true,
  "workbench.experimental.share.enabled": true,
  "workbench.commandPalette.experimental.suggestCommands": true,
  "workbench.experimental.modernUI": false,
  "http.experimental.systemCertificatesV2": true,
  "notebook.variablesView": true,
  "ipynb.experimental.serialization": true,
  "search.experimental.closedNotebookRichContentResults": true,
  "extensions.experimental.deferredStartupFinishedActivation": true,

  "debug.toolBarLocation": "docked",

  "editor.fontSize": 14,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.wordWrap": "off",
  "editor.lineNumbers": "off",
  "editor.rulers": [
    80
  ],
  "editor.guides.indentation": false,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.inlayHints.padding": true,
  "editor.peekWidgetDefaultFocus": "editor",
  "editor.semanticHighlighting.enabled": true,
  "editor.cursorSurroundingLines": 4,
  "editor.formatOnPaste": true,

  "workbench.colorTheme": "oxocarbon",
  "workbench.preferredDarkColorTheme": "oxocarbon OLED",
  //  "workbench.preferredLightColorTheme": "oxocarbon",
  "workbench.preferredLightColorTheme": "PRINT",
  "workbench.productIconTheme": "icons-carbon",
  "workbench.iconTheme": null,
  "workbench.list.smoothScrolling": true,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.fontAliasing": "auto",
  "workbench.editor.showTabs": "single",
  "workbench.settings.editor": "json",
  "workbench.settings.openDefaultKeybindings": true,
  "workbench.settings.openDefaultSettings": true,

  "breadcrumbs.enabled": false,

  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.ignoreLegacyWarning": true,
  "git.ignoreMissingGitWarning": true,

  "zenMode.showTabs": "none",
  "zenMode.centerLayout": false,
  "zenMode.silentNotifications": false,

  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.enableVisualBell": true,

  "files.autoGuessEncoding": true,
  "files.hotExit": "off",

  "window.customTitleBarVisibility": "windowed",
  "window.menuStyle": "native",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "window.autoDetectColorScheme": true,

  "search.globalFindClipboard": true,
  "search.decorations.badges": false,

  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "extensions.ignoreRecommendations": true,

  "vim.statusBarColorControl": false,
  //  "vim.statusBarColors.commandlineinprogress": ["#0f62fe", "#ffffff"],
  //  "vim.statusBarColors.insert": ["#161616", "#ffffff"],
  //  "vim.statusBarColors.normal": ["#000000", "#ffffff"],
  //  "vim.statusBarColors.replace": ["#0f62fe", "#ffffff"],
  //  "vim.statusBarColors.searchinprogressmode": ["#0f62fe", "#ffffff"],
  //  "vim.statusBarColors.surroundinputmode": ["#0f62fe", "#ffffff"],
  //  "vim.statusBarColors.visual": ["#0f62fe", "#ffffff"],
  //  "vim.statusBarColors.visualblock": ["#0f62fe", "#ffffff"],

  "print.sourcecode.colourScheme": "Google Code",
  "print.sourcecode.lineNumbers": "off",

  "excel-viewer.showInfo": false,
  "editor.minimap.enabled": false,

  "[rust]": {
    "editor.semanticHighlighting.enabled": false
  },
  "[markdown]": {
    "editor.wordWrap": "off"
  },

  "editor.bracketPairColorization.enabled": false,
  "[commonlisp]": {
    "editor.bracketPairColorization.enabled": true
  },

  "security.workspace.trust.untrustedFiles": "open",

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.js": "${capture}.js.map",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },

  "chat.agent.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki": true,
    "https://developer.apple.com": true,
    "https://pypi.org": true,
    "https://codeberg.org": true,
    "https://github.com": true
  },
  //  "chat.agent.maxRequests": 90000,
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.editing.confirmEditRequestRetry": false,
  "chat.agent.sandbox.enabled": "on",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ]
}
